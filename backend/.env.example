# DASIGConnect Backend — environment template
# Copy to backend/.env and fill in real values. .env is gitignored; never commit it.
# The authority for every key and its default is src/main/resources/application.properties.
# Keys shown without a "# optional" note are required for that feature to work.

# ── Database ────────────────────────────────────────────────────────────────
# LOCAL DEVELOPMENT: run `docker compose up -d` (repo root) and use the values
# below as-is. Do NOT point local dev at the shared Supabase database — every
# local backend runs the scheduler + media/analytics queries and that traffic
# is billed as Supabase egress.
DASIG_DATABASE_URL=jdbc:postgresql://localhost:5432/dasigconnect
DASIG_DATABASE_USER=postgres
DASIG_DATABASE_PASSWORD=postgres
#
# DEPLOYED (Render → Supabase Session Pooler): set these in the host's env, not
# here. Legacy fallbacks also read DATABASE_URL / DATABASE_USER / DATABASE_PASSWORD.
#   DASIG_DATABASE_URL=jdbc:postgresql://<pooler-host>:5432/postgres
#   DASIG_DATABASE_USER=postgres.<project-ref>
#   DASIG_DATABASE_PASSWORD=<supabase-db-password>

# Supabase service-role key — optional. Only used as an auth fallback when Claude
# Vision fetches Supabase-hosted images. Not needed while media is served from R2.
# Fallback name: SUPABASE_SERVICE_ROLE_KEY
DASIG_SUPABASE_SERVICE_ROLE_KEY=

# ── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=<min-32-char-random-secret>
# optional — access-token lifetime in minutes (default 480)
JWT_TTL_MINUTES=480

# ── Frontend URL (used in invitation / reset email links) ───────────────────
APP_FRONTEND_BASE_URL=http://localhost:5173

# ── Email (Resend HTTP API — no SMTP) ──────────────────────────────────────
# RESEND_API_KEY  — Resend dashboard → API Keys. Blank disables outbound email.
# MAIL_FROM       — must be an address on a domain verified in Resend.
RESEND_API_KEY=re_...
MAIL_FROM=no-reply@<verified-domain>
# optional
MAIL_API_BASE_URL=https://api.resend.com
MAIL_FROM_NAME=DASIGConnect
MAIL_REPLY_TO=<reply-to-address>
# optional — if set, a startup smoke-test email is sent to this address
MAIL_SMOKE_TEST_TO=

# ── Facebook Graph API ─────────────────────────────────────────────────────
FACEBOOK_PAGE_ACCESS_TOKEN=<long-lived-page-access-token>
FACEBOOK_PAGE_ID=<numeric-page-id>
# Required for the OAuth re-authentication flow (token re-auth from System Audit)
FACEBOOK_APP_ID=<app-id>
FACEBOOK_APP_SECRET=<app-secret>
# optional
FACEBOOK_API_VERSION=v25.0
FACEBOOK_OAUTH_REDIRECT_URI=http://localhost:8080/api/v1/facebook/oauth-callback

# ── Messenger (validator notifications) ────────────────────────────────────
# optional — all fall back to the FACEBOOK_* values above; set only to override.
MESSENGER_ENABLED=true
# MESSENGER_PAGE_ACCESS_TOKEN=
# MESSENGER_PAGE_ID=
# MESSENGER_APP_SECRET=
# MESSENGER_VERIFY_TOKEN=            (fallback: FACEBOOK_MESSENGER_VERIFY_TOKEN)
# MESSENGER_API_VERSION=v25.0

# ── External AI APIs ───────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# optional
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
VOYAGE_API_KEY=pa-...

# ── Cloudflare R2 object storage (media assets) ────────────────────────────
# R2_ENDPOINT        = bucket → Settings → "S3 API" URL, no trailing slash
# R2_PUBLIC_BASE_URL = bucket's Public Development URL (https://pub-<hash>.r2.dev), no trailing slash
# R2_ACCOUNT_ID / R2_ENDPOINT are not secret; the API key pair is.
R2_ACCOUNT_ID=<account-id>
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=<r2-access-key-id>
R2_SECRET_ACCESS_KEY=<r2-secret-access-key>
R2_BUCKET=dasigconnect-media
R2_PUBLIC_BASE_URL=https://pub-<hash>.r2.dev

# ── Optional tunables (safe defaults in application.properties) ─────────────
# APP_ADMINS_MAX=3
# APP_GUARDRAILS_ENFORCED=false
APP_DB_DIAGNOSTICS_ENABLED=false
# FLYWAY_BASELINE_ON_MIGRATE=true
# FLYWAY_BASELINE_VERSION=0
# MEDIA_ASSET_DELETED_RETENTION_DAYS=30
# MEDIA_ASSET_PURGE_BATCH_SIZE=25
# MEDIA_ASSET_PURGE_CRON=0 30 2 * * *
# SYSTEM_HEALTH_DATABASE_LIMIT_BYTES=500000000
# SYSTEM_HEALTH_MEDIA_LIMIT_BYTES=10000000000
# SYSTEM_HEALTH_STORAGE_WARNING_THRESHOLD_PERCENT=80
# SYSTEM_HEALTH_STORAGE_CRITICAL_THRESHOLD_PERCENT=95

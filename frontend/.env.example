# DASIGConnect Frontend — environment template (Vite)
# Copy to frontend/.env (or .env.local). Only VITE_-prefixed vars reach the client.

# Backend REST base URL. Falls back to "/api/v1" if unset.
VITE_API_URL=http://localhost:8080/api/v1

# Supabase (not referenced by the current src/ — direct-to-Supabase upload was
# replaced by R2. Kept for reference; set only if that path is reintroduced.)
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_ANON_KEY=<supabase-publishable-key>
# VITE_SUPABASE_STORAGE_BUCKET=dasigconnect-media
